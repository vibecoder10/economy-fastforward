# ============================================
# YOUTUBE
# ============================================
# API key (optional — for transcript extraction only)
# YOUTUBE_API_KEY=xxxxx

# yt-dlp anti-bot escape hatches (StoryEngine backend — routes/niche.py).
# YouTube flags the VPS datacenter IP ("Sign in to confirm you're not a bot"),
# which kills per-video metadata + transcripts. Set ONE of:
# YTDLP_COOKIES_FILE=/home/clawd/.config/storyengine/youtube_cookies.txt  # Netscape cookies.txt exported from a logged-in browser
# YTDLP_PROXY=socks5://user:pass@host:port                                # proxy with an unflagged egress IP

# OAuth2 credentials for upload + analytics (stored as JSON files):
#   .youtube-credentials.json — OAuth client (from Google Cloud Console)
#   .youtube-token.json — Generated by running: python youtube_auth.py
# Scopes: youtube.upload, youtube.readonly, yt-analytics.readonly

# ============================================
# APIFY (YouTube trending video scraping)
# ============================================
# Used by trending_idea_bot.py to scrape competitor channels
APIFY_API_KEY=xxxxx

# ============================================
# ANIMATION PIPELINE (R50 | Cinematic Adverts System)
# ============================================
# Separate Airtable base for animation production
AIRTABLE_ANIMATION_BASE_ID=appB9RWwCgywdwYrT
AIRTABLE_PROJECT_TABLE=tblYiND5DkrZhIlLq
AIRTABLE_SCENES_TABLE=tblipThhapetdSJdm

# Animation budget defaults
ANIMATION_BUDGET_DEFAULT=20
MAX_REGEN_ATTEMPTS=2

# ============================================
# STORYENGINE FEATURE FLAGS
# ============================================
# Per-user API key resolution (PRD slice 4). Default false (safe to omit).
PER_USER_KEYS_ENABLED=false
