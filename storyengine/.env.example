# Supabase
SUPABASE_URL=https://rcbobwaldrefnyllhjyo.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret
DATABASE_URL=postgresql://postgres:password@db.rcbobwaldrefnyllhjyo.supabase.co:5432/postgres

# Airtable (for sync bridge)
AIRTABLE_API_KEY=your-airtable-pat
AIRTABLE_BASE_ID=appCIcC58YSTwK3CE

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8001
NEXT_PUBLIC_SUPABASE_URL=https://rcbobwaldrefnyllhjyo.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Vision canary + provider routing (all optional — sane defaults baked in)
# KIE_CHAT_API_BASE=https://api.kie.ai          # Kie's OpenAI-compatible chat base (Gemini vision)
# VISION_CANARY_TENANT=ee93e6d1-a9cc-44c3-81e9-84adee8329aa   # tenant whose Kie key the canary spends (~$0.002/run)
# VISION_CANARY_IMAGE_URL=                      # known test image (defaults to the Supabase-hosted red-circle PNG)

# ── Auth (REQUIRED for prod) ────────────────────────────────────────────────
# Strong random secret that signs session JWTs. Generate: openssl rand -hex 32
# Auth FAILS CLOSED without it (login/verify return 500/401).
SESSION_SECRET=
# Leave DEV_MODE unset in prod. If "true" + DEV_TOKEN set, a static token logs in.
# DEV_MODE=
# DEV_TOKEN=
# DEV_TENANT_ID=

# ── Stripe billing (REQUIRED to take payments) ──────────────────────────────
# From the Stripe dashboard. LIVE keys for real charges (sk_live_…). The price
# IDs must match the products you create (Starter/Pro/Studio). See LAUNCH-CHECKLIST.md.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_PRICE_AGENCY=

# ── Job queue (REQUIRED for reliable generation under load) ─────────────────
# Redis backs the arq worker. Without it, pipeline stages run inside the web
# process and the API stalls under concurrent load. Install Redis + enable
# storyengine-worker.service (see backend/storyengine-worker.service).
REDIS_URL=redis://localhost:6379

# ── Public URLs / CORS (prod domain: storyengine.dev) ───────────────────────
# After the reverse proxy + cert land (see infra/Caddyfile.example), these point
# at the real domain. Stripe redirects + Secure cookies require HTTPS.
FRONTEND_URL=https://storyengine.dev
ALLOWED_ORIGINS=https://storyengine.dev
# Frontend build-time API base — app + API share the origin. Rebuild the
# frontend (next build) after changing this; it's baked in at build time.
NEXT_PUBLIC_API_URL=https://storyengine.dev

# Protects /api/health/detailed (leaks queue/error/memory if unset). Generate one.
HEALTH_TOKEN=

# Per-tenant generation key lives in the vault (Settings → API Keys), not here.
# An env KIE_AI_API_KEY only acts as a last-resort fallback for keyless tenants.
# KIE_AI_API_KEY=

# ── Custom Film Scene Control (dark unless explicitly enabled) ──────────────
CUSTOM_FILM_SCENE_CONTROL_V1=false
CUSTOM_FILM_SCENE_STORYBOARD_EXECUTION_V1=false
# Independently exposes the authenticated frontend entry and route affordance.
# Omitted/false keeps Scene Control dark even when a Custom Film plan exists.
NEXT_PUBLIC_CUSTOM_FILM_SCENE_CONTROL_V1=false
# Exact server-owned maximum cents per initial call. Missing values fail
# closed at quote time. GPT Image 2 storyboard work uses the canonical $0.05.
CUSTOM_FILM_SCENE_STORYBOARD_IMAGE_MAX_CENTS=5
CUSTOM_FILM_SCENE_FINAL_IMAGE_MAX_CENTS=
CUSTOM_FILM_SCENE_ANIMATION_MAX_CENTS=
CUSTOM_FILM_SCENE_VOICE_LINE_MAX_CENTS=
