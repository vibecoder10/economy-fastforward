[Unit]
Description=Fires storyengine-vision-canary.service every hour
Requires=storyengine-vision-canary.service

[Timer]
# Hourly (vs the validator canary's 6h): vision drift silently degrades the
# north-star modeling feature and the 2026-06-12 incident lasted under a
# day — 6h detection would have missed most of it. ~$1.5/month at this rate.
OnBootSec=10min
OnUnitActiveSec=1h
AccuracySec=2min
Persistent=true

[Install]
WantedBy=timers.target
