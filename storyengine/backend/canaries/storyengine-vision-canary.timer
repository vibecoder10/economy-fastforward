[Unit]
Description=Fires storyengine-vision-canary.service every 3 hours
Requires=storyengine-vision-canary.service

[Timer]
# Every 3h (vs the validator canary's 6h): vision drift silently degrades the
# north-star modeling feature and the 2026-06-12 incident lasted under a day —
# 3h still catches it same-day while cutting the Kie vision calls ~3x. ~$0.5/month.
OnBootSec=10min
OnUnitActiveSec=3h
AccuracySec=2min
Persistent=true

[Install]
WantedBy=timers.target
